include LICENSE README.md CHANGELOG.md CONTRIBUTING.md CITATION.cff Makefile
include main.py pyproject.toml

recursive-include dashboard *
recursive-include .github *
include .gitattributes .gitignore .pre-commit-config.yaml
include Results/demne_params_published.json
recursive-include data *
recursive-include docs *
recursive-include scripts *
recursive-include src/demne *
recursive-include tests *

# Clinical annotation data must never ship in an sdist (PyPI / Zenodo).
global-exclude *.ann
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.egg-info
